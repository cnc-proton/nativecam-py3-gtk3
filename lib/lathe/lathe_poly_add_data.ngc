o<lathe_poly_add_data> sub
(CNC Proton — compile one lathe profile record with optional A/C corner)

	#[#1] = [#[#1] + 1]

	#<ptr> = [#1 - #[#1] * 8 - 1]
	#[#<ptr>    ] = #2
	#[#<ptr> + 1] = #3
	#[#<ptr> + 2] = #4
	#[#<ptr> + 3] = #5
	#[#<ptr> + 4] = #6
	#[#<ptr> + 5] = #7
	#[#<ptr> + 6] = #8

o<lathe_poly_add_data> endsub
