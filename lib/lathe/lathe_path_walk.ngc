o<lathe_path_walk> sub
(CNC Proton — walk compiled profile records and invoke lathe_xz_move)
(#1 record table pointer, #2 depth flag, #3 exit style)

	#<tbl>    = [#1 + 1]
	#<nrec>    = #[#1]
	#<idx>     = 0
	#<cursor>  = #<tbl>

	o<lpw_arm> if [[#<_depth_reached> EQ -1] AND [#<_cut_current_z> LE #2]]
		#<_depth_reached> = 0
	o<lpw_arm> endif

	o<lpw_loop> while [#<idx> LT #<nrec>]
		#<idx> = [#<idx> + 1]
		o<lathe_xz_move> CALL [#[#<cursor>]] [#[#<cursor> + 1]] [#[#<cursor> + 2]] \
			[#[#<cursor> + 3] - #<_cut_current_x>] [#[#<cursor> + 4] - #<_cut_current_y>] [0] [#[#<cursor> + 5]] [#[#<cursor> + 6]]

		o<lpw_early> if [#3 EQ 1]
			o<lpw_hit> if [#<_depth_reached> EQ #<idx>]
				#<_depth_reached> = 0
				o<lathe_depart> CALL [#1] [#<idx> - 1] [#4] [#5] [#6]
				o<lathe_path_walk> return
			o<lpw_hit> elseif [[#<_depth_reached> EQ -1] AND [#<_cut_current_z> LE #2]]
				#<_depth_reached> = #<idx>
				#3 = 0
			o<lpw_hit> endif
		o<lpw_early> endif

		#<cursor> = [#<cursor> + 8]
	o<lpw_loop> endwhile

	o<lpw_tail> if [[#<_depth_reached> EQ 0] AND [#3 EQ 2]]
		o<lathe_depart> CALL [#1] [#<idx> - 1] [#4] [#5] [#6]
	o<lpw_tail> endif

o<lathe_path_walk> endsub
