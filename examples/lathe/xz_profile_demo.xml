    <param type="bool" call="#param_act" name="Active" value="1" icon="enable.png"/>
    <param type="sub-header" call="#param_rough" name="Roughing cycle"/>
    <param type="combo" call="#param_mode" name="Cycle type" header="rough" value="0" options="Step-down along X (all LCNC)=0:G71 contour rough (LCNC 2.9+)=71:G72 face rough (LCNC 2.9+)=72"/>
