    <param type="combo" call="#param_wmode" name="Work mode" header="h2" value="7" options="Diameter=7:Radius=8" icon="circle-rad-dia.png"/>
    <param type="float" call="#param_x_rap" name="X Rapid" header="h2" value="0.50" metric_value="12.0" icon="lathe-rappid-x.png"/>
    <param type="float" call="#param_z_rap" name="Z Rapid" header="h2" value="0.50" metric_value="12.0" icon="lathe-rappid.png"/>
  </feature>
  <feature src="lathe/tool-change.cfg" name="Tool Change" type="tool_change" icon="lathe-tool-change.png" id="tool_change_001" expanded="False">
    <param type="bool" call="#param_act" name="Active" value="1" icon="enable.png"/>
    <param type="sub-header" call="#param_h1" name="Tool and usage"/>
    <param type="tool" call="#param_dnum" name="Tool number" header="h1" value="1" icon="lathe-tool.png"/>
    <param type="combo" call="#param_us" name="Usage" header="h1" value="0" options="Roughing and finishing=0:Roughing=1:Finishing=2" icon="tool-usage.png"/>
    <param type="combo" call="#param_spindle_dir" name="Start spindle" header="h1" value="3" options="No=5:Clockwise=3:Counter-clockwise=4" icon="lathe-dir.png"/>
    <param type="combo" call="#param_cooling" name="Use cooling" header="h1" value="8" options="None=9:Flood=8:Mist=7" icon="snowflake.png"/>
    <param type="sub-header" call="#param_h2" name="Spindle speed"/>
    <param type="combo" call="#param_mode" name="Mode" header="h2" value="1" options="Constant surface=0:RPM=1" icon="lathe-chuck.png"/>
    <param type="int" call="#param_speed" name="Surface/spindle speed" header="h2" value="800" icon="tool-spindle.png"/>
    <param type="int" call="#param_max_speed" name="Max spindle speed" header="h2" value="1500" icon="tool-spindle.png"/>
    <param type="sub-header" call="#param_h8" name="Roughing"/>
    <param type="float" call="#param_r_feed" name="Feed" header="h8" value="5.0" metric_value="125.0" icon="lathe-feed.png"/>
    <param type="float" call="#param_c_dpt" name="Cut depth" header="h8" value="0.02" metric_value="0.5" icon="lathe-depth-step.png"/>
    <param type="sub-header" call="#param_h4" name="Finishing"/>
    <param type="float" call="#param_f_feed" name="Feed" header="h4" value="2.0" metric_value="50.0" icon="lathe-feed.png"/>
    <param type="float" call="#param_fc_dpt" name="Cut depth" header="h4" value="0.01" metric_value="0.25" icon="lathe-depth-step.png"/>
    <param type="sub-header" call="#param_hc" name="Clearances"/>
    <param type="float" call="#param_x_safe" name="X clear" header="hc" value="0.125" metric_value="3.0" icon="lx-clear.png"/>
    <param type="float" call="#param_ix_safe" name="Internal X clear" header="hc" value="0.040" metric_value="1.0" icon="ix-clear.png"/>
    <param type="float" call="#param_z_safe" name="Z clear" header="hc" value="0.125" metric_value="3.0" icon="lz-clear.png"/>
  </feature>
