    <param type="sub-header" call="#param_h_ax" name="Longitudinal axis"/>
    <param type="float" call="#param_z0" name="Profile start Z" header="h_ax" value="0.0" metric_value="0.0" icon="z.png"/>
    <param type="items" call="#param_items" name="Segments" icon="items.png" expanded="True">
      <feature src="lathe/xz_line.cfg" name="XZ Line" type="turn_xz_line" icon="line-to.png" id="xz_line_001">
        <param type="bool" call="#param_act" name="Active" value="1" icon="enable.png"/>
        <param type="sub-header" call="#param_hdr" name="End point"/>
        <param type="float" call="#param_dia" name="X diameter" header="hdr" value="2.0" metric_value="50.0" icon="x.png"/>
        <param type="float" call="#param_zed" name="Z" header="hdr" value="-2.0" metric_value="-50.0" icon="z.png"/>
        <param type="combo" call="#param_mode" name="Coordinate mode" header="hdr" value="1" options="Incremental=0:Absolute=1:Z incr, X abs=10:Z abs, X incr=11" icon="line-rel.png"/>
      </feature>
      <feature src="lathe/xz_line.cfg" name="XZ Line" type="turn_xz_line" icon="line-to.png" id="xz_line_002">
        <param type="bool" call="#param_act" name="Active" value="1" icon="enable.png"/>
        <param type="sub-header" call="#param_hdr" name="End point"/>
        <param type="float" call="#param_dia" name="X diameter" header="hdr" value="1.6" metric_value="40.0" icon="x.png"/>
        <param type="float" call="#param_zed" name="Z" header="hdr" value="-4.0" metric_value="-100.0" icon="z.png"/>
        <param type="combo" call="#param_mode" name="Coordinate mode" header="hdr" value="1" options="Incremental=0:Absolute=1:Z incr, X abs=10:Z abs, X incr=11" icon="line-rel.png"/>
      </feature>
    </param>
  </feature>
</lcnc-ncam>
