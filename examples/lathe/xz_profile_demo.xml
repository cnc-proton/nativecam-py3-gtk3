<?xml version="1.0" encoding="UTF-8"?>
<lcnc-ncam>
  <feature src="proj_desc.cfg" name="Project Description" type="comment" icon="prj-desc.png" id="comment_001" expanded="False">
    <param type="prjname" call="#param_pn" name="Project name" value="XZ profile demo"/>
    <param type="text" call="#param_n" name="Note" value="Turning contour sample — step-down, G71, or G72 from XZ Profile cycle."/>
  </feature>
  <feature src="lathe/material.cfg" name="Workpiece" type="workpiece" icon="l-stock.png" id="workpiece_001" expanded="False">
    <param type="bool" call="#param_sh" name="Show limits" value="0"/>
    <param type="sub-header" call="#param_h1" name="Size and coord"/>
    <param type="float" call="#param_od" name="Ext. diameter" header="h1" value="2.0" metric_value="50.0" icon="e-diam.png"/>
    <param type="float" call="#param_id" name="Int. diameter" header="h1" value="0.0" metric_value="0.0" icon="i-diam.png"/>
    <param type="float" call="#param_l" name="Length" header="h1" value="10.0" metric_value="250.0" icon="width.png"/>
    <param type="float" call="#param_z" name="Begin position" header="h1" value="0.0" metric_value="0.0" icon="z.png"/>
